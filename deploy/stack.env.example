# Mission Control — Portainer stack environment variables
#
# In Portainer: paste these into the stack's "Environment variables" section
# (Advanced mode → "Load variables from .env file" accepts this format).
# Anything left blank falls back to the default baked into docker-stack.yml.

# ── Image tag ────────────────────────────────────────────────────────────────
# Which tag to pull from ghcr.io/gmoigneu/mission-control-{api,frontend}.
IMAGE_TAG=latest

# ── Required secrets ─────────────────────────────────────────────────────────
# Session signing key. REQUIRED (the API refuses to boot with the default when
# ENVIRONMENT != development). Generate:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Neo4j password. REQUIRED. Used for both the neo4j container auth and the API.
NEO4J_PASSWORD=change-me-neo4j
NEO4J_USER=neo4j

# Postgres credentials (internal only — not published on a host port).
POSTGRES_USER=mc
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=mc

# ── First login (bootstraps an account on startup) ───────────────────────────
INITIAL_USER_EMAIL=you@example.com
INITIAL_USER_PASSWORD=change-me-strong-password

# ── Passkeys / WebAuthn ──────────────────────────────────────────────────────
# Must match the public domain users actually load (the global Caddy vhost).
# RP_ID is the registrable domain (no scheme/port); RP_ORIGIN is the full https
# origin. Passkeys require HTTPS — which the global Caddy provides.
WEBAUTHN_RP_ID=mission-control.example.com
WEBAUTHN_RP_NAME=Mission Control
WEBAUTHN_RP_ORIGIN=https://mission-control.example.com

# ── AI providers (optional — defaults run fully offline) ─────────────────────
# EMBEDDINGS_PROVIDER: fake | openai | openrouter
EMBEDDINGS_PROVIDER=fake
# LLM_PROVIDER: mock | openai_oauth | openrouter
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_EMBEDDINGS_MODEL=openai/text-embedding-3-small
