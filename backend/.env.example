ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://mc:mc@localhost:5432/mc
TEST_DATABASE_URL=postgresql+asyncpg://mc:mc@localhost:5432/mc_test
SESSION_SECRET=  # generate: python -c "import secrets; print(secrets.token_hex(32))"
INITIAL_USER_EMAIL=
INITIAL_USER_PASSWORD=

# ── Passkeys / WebAuthn ──────────────────────────────────────────────────────
# RP id is the registrable domain (no scheme/port); origin is the full origin
# the browser reports. Must match the site users actually load.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Mission Control
WEBAUTHN_RP_ORIGIN=http://localhost:5173

# ── Deploy-only vars (used by docker compose --profile deploy) ───────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=mc-neo4j-pw
NEO4J_URI=bolt://localhost:7687
# EMBEDDINGS_PROVIDER: "fake" (offline default) | "openai" | "openrouter".
# For "openai", set OPENAI_API_KEY to a standard sk- embeddings key
# (the Codex/ChatGPT-subscription OAuth credential is chat-only).
# For "openrouter", set OPENROUTER_API_KEY (below) — billed via OpenRouter.
EMBEDDINGS_PROVIDER=fake
OPENAI_API_KEY=
# LLM_PROVIDER: "mock" (offline default) | "openai_oauth" | "openrouter".
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
# ── OpenRouter ───────────────────────────────────────────────────────────────
# OpenAI-compatible. Powers the agent (LLM_PROVIDER=openrouter) and/or
# embeddings (EMBEDDINGS_PROVIDER=openrouter); OPENROUTER_API_KEY is required
# for either. OPENROUTER_MODEL is the chat model; OPENROUTER_EMBEDDINGS_MODEL
# the embeddings model (must be 1536-dim to match the search schema).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_EMBEDDINGS_MODEL=openai/text-embedding-3-small
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Telegram gateway (optional) ──────────────────────────────────────────────
# Remote access to Mission Control via a Telegram bot. The bot is off unless
# TELEGRAM_BOT_TOKEN is set (get one from @BotFather).
#   - TELEGRAM_WEBHOOK_SECRET: any random string; Telegram echoes it back in the
#     X-Telegram-Bot-Api-Secret-Token header so we can verify inbound updates.
#     Generate: python -c "import secrets; print(secrets.token_hex(32))"
#   - TELEGRAM_ALLOWED_CHAT_IDS: comma-separated chat ids allowed to use the bot
#     (this is the access boundary). Message the bot, then read your chat id from
#     the webhook logs or @userinfobot.
#   - TELEGRAM_WEBHOOK_BASE_URL: public base URL of the deployment; the webhook is
#     registered at {base}/api/telegram/webhook. After setting these, run:
#       uv run python -m app.cli telegram set-webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_BASE_URL=
