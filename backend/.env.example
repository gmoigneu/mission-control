ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://mc:mc@localhost:5432/mc
TEST_DATABASE_URL=postgresql+asyncpg://mc:mc@localhost:5432/mc_test
SESSION_SECRET=  # generate: python -c "import secrets; print(secrets.token_hex(32))"
INITIAL_USER_EMAIL=
INITIAL_USER_PASSWORD=

# ── Deploy-only vars (used by docker compose --profile deploy) ───────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=mc-neo4j-pw
NEO4J_URI=bolt://localhost:7687
# Semantic search embeddings. Default "fake" (deterministic, no network/deps).
# Set to "openai" to use the real OpenAI embeddings API — requires the optional
# `openai` package (`uv sync --extra openai`) and a standard sk-... OPENAI_API_KEY
# (separate from the agent's ChatGPT-subscription OAuth credential).
EMBEDDINGS_PROVIDER=fake
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIM=1536
OPENAI_API_KEY=
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
